{
  "expo": {
    "name": "Saff",
    "slug": "saff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "edu.ucsd.saff",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10B981",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "edu.ucsd.saff"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Saff",
      "shortName": "Saff",
      "themeColor": "#000000",
      "backgroundColor": "#FFFFFF",
      "display": "standalone"
    },
    "plugins": [
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F4F2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B0F"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "901fcf34-3eb9-443c-ab8d-ec3a99cf9451"
      }
    },
    "owner": "evanlyy168",
    "runtimeVersion": "exposdk:58.0.0",
    "updates": {
      "url": "https://u.expo.dev/901fcf34-3eb9-443c-ab8d-ec3a99cf9451"
    }
  }
}
