# Copy this file to .env (cp .env.example .env), then restart Expo.
# It points the app at the live Saff server on Replit (always on, real prayer times).
EXPO_PUBLIC_SERVER_URL=https://saff-alimran13.replit.app

# Running the server on your own laptop instead? Use your laptop's Wi-Fi IP, not localhost:
# EXPO_PUBLIC_SERVER_URL=http://192.168.1.10:4000

# Leave EXPO_PUBLIC_SERVER_URL unset (delete .env) for offline demo mode.
# ADMIN_KEY (to fire an adhan by hand) is NOT here on purpose: ask Ali for it.
